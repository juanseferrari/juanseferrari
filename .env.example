# --- Supabase -------------------------------------------------------------
# Proyecto "juanseferrari-training" (separado de Maneki).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable / anon key. Lecturas publicas: el calendario, que es de solo
# lectura. Es la que ya usa /weight/new.
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secret / service role key. Escrituras del lado del server: seed del plan,
# actividades de Strava y overrides. NUNCA se manda al cliente.
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Auth -----------------------------------------------------------------
# Unico email autorizado a entrar (magic link de Supabase Auth).
TRAINING_EMAIL=vos@ejemplo.com

# Secreto para firmar la cookie de sesion. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# URL publica del sitio, para armar el redirect del magic link.
SITE_URL=https://www.juanseferrari.com

# --- Strava ---------------------------------------------------------------
# De https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Callback del OAuth. Tiene que coincidir con el "Authorization Callback
# Domain" configurado en Strava (ahi va solo el dominio, sin https ni path).
STRAVA_REDIRECT_URI=https://www.juanseferrari.com/training/connect/callback

# Webhook: token que elegis vos, Strava te lo devuelve para verificar.
STRAVA_VERIFY_TOKEN=
STRAVA_WEBHOOK_URL=https://www.juanseferrari.com/api/strava/webhook

# --- Cron -----------------------------------------------------------------
# Secreto para el resync nocturno (Heroku Scheduler).
CRON_SECRET=
